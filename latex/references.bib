@article{westergaard.etal2017,
  title = {Crosslinguistic Influence in the Acquisition of a Third Language: {{The Linguistic Proximity Model}}},
  shorttitle = {Crosslinguistic Influence in the Acquisition of a Third Language},
  author = {Westergaard, Marit and Mitrofanova, Natalia and Mykhaylyk, Roksolana and Rodina, Yulia},
  date = {2017-12},
  journaltitle = {International Journal of Bilingualism},
