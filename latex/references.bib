@article{akulov2017,
  title = {A {{Minoan}} Deity from {{London Medicine Papyrus}}},
  author = {Akulov, Alexander},
  date = {2017-06-29},
  journaltitle = {Cultural Anthropology and Ethnosemiotics},
  shortjournal = {Cultural Anthropology and Ethnosemiotics},
  volume = {3},
  abstract = {In London Medicine Papyrus, in incantation against samuna ubuqi illness there are two names of Minoan deities. One of them is determined as Maja that evidently is correlated with Maia of ancient Greek mythology. Maia of ancient Greek mythology is the oldest of seven Pleiades. Pleiades were connected with seafaring since the season of navigation in Mediterranean region began with their heliacal rising. Minoan Maia could be protector of sailors; use of name Maja in an incantation against a disease is completely logical since seafaring was very important of Minoan people, and so a deity that was protector of sailors evidently was considered as a mighty one and could also be an effective protector against other troubles. The fact that name Maja is written with determinative " god " , but not " goddess " in the incantation while in Greek mythology Maia is goddess, hints that initially Maja could be androgynous/bigender deity.}
