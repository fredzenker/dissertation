@article{hashimoto.iwasaki,
  title = {Relative Clauses with Split Antecedents in {{English}}: {{Where}} Is the Antecedent?},
  author = {Hashimoto, Tatsuya and Iwasaki, Hiroyuki},
  abstract = {This paper provides a novel analysis of Relative Clauses with Split Antecedents (RCSA) in English under the framework of Minimalist Program. RCSA is a set of sentences where more than one antecedent nominal of an apparently extraposed relative clause are splitting into two clauses (e.g. A man entered the room and a woman went out who were quite similar.). As alluded to in the last sentence, the relative clause in RCSA cannot in fact be rightward-moved. The most intriguing fact about RCSA is that the relative clause can contain expressions which require a plural subject. This leads us to conclude that any adequate syntactic analysis of RCSA must construct a configuration at some abstract level in which antecedent nominals are coordinated. It is a non-trivial issue how to generate this coordinate structure. This paper proposes a syntactic operation which we dub Shared-D Raising and claims that it works in tandem with Reintegration (Maezawa (2019)) for deriving the coordinate structure in question. It will be shown that our proposed mechanism can account for the properties of RCSA.},
