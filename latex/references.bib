  shorttitle = {The {{Now-or-Never}} Bottleneck},
  author = {Christiansen, Morten H. and Chater, Nick},
  date = {2016},
  journaltitle = {Behavioral and Brain Sciences},
  shortjournal = {Behav Brain Sci},
  volume = {39},
