@thesis{mccarthy2005,
  type = {phdthesis},
  title = {An Assessment of the Range and Usefulness of Lexical Diversity Measures and the Potential of the Measure of Textual, Lexical Diversity ({{MTLD}})},
  author = {McCarthy, Philip M.},
  date = {2005},
